{
  "type": "module",
  "name": "tuple-ts",
  "version": "0.9.0",
  "description": "TypeScript-first tuples and structs with value-based identity",
  "keywords": [
    "tuple",
    "struct",
    "labeled",
    "labelled",
    "named",
    "namedtuple",
    "named-tuple",
    "python",
    "equality",
    "identity",
    "shallow-equality",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geobrad/tuple-ts.git"
  },
  "bugs": {
    "url": "https://github.com/geobrad/tuple-ts/issues"
  },
  "homepage": "https://github.com/geobrad/tuple-ts",
  "exports": {
    "types": "./dist/index.d.ts",
    "import": "./dist/index.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "rm -r dist/ && tsc && esbuild src/index.ts --bundle --minify --format=esm --platform=browser --target=es2023 --outfile=dist/tuple-ts.min.js",
    "test": "tsc -p tsconfig.test.json --noEmit && vitest run src/",
    "prepare": "npm run build",
    "prepublishOnly": "npm test"
  },
  "author": "George Bradley <george@gbrad.com> (https://gbrad.com/)",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "files": [
    "./dist"
  ]
}
